# Matches the measured house style: 2-space indent, LF, UTF-8, single trailing newline.
# Kept alongside .prettierrc.json so an editor agrees with the formatter.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
