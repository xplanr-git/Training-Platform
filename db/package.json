{
  "name": "@training-platform/db",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=20 <21"
  },
  "type": "module",
  "description": "v2 Drizzle schema, migrations, and query helpers (source of truth for the database).",
  "main": "index.ts",
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "push": "drizzle-kit push",
    "studio": "drizzle-kit studio",
    "check": "drizzle-kit check",
    "verify": "npm run format:check && npm run check && tsc --noEmit",
    "format:check": "prettier --check \"*.ts\"",
    "format": "prettier --write \"*.ts\""
  },
  "dependencies": {
    "drizzle-orm": "^0.36.4",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "drizzle-kit": "^0.28.1",
    "prettier": "3.6.2",
    "typescript": "^5.6.3"
  }
}
