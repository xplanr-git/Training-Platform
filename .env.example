# Supabase connection (client-side, exposed to the browser by design).
# Find these in your Supabase project: Settings → API.
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# api.video — video hosting. Sandbox is free and watermarks playback;
# production (https://ws.api.video) is billed. Base URL is explicit so a key
# can never silently hit the billed environment.
APIVIDEO_API_KEY=
APIVIDEO_BASE_URL=https://sandbox.api.video

# Bunny Stream — alternative video provider. Library-scoped access key.
BUNNY_API_KEY=
BUNNY_LIBRARY_ID=
BUNNY_CDN_HOSTNAME=
