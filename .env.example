# Supabase connection (client-side, exposed to the browser by design).
# Find these in your Supabase project: Settings → API.
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>


# Bunny Stream — alternative video provider. Library-scoped access key.
BUNNY_API_KEY=
BUNNY_LIBRARY_ID=
BUNNY_CDN_HOSTNAME=
