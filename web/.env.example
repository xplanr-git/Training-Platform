# Next.js app environment. Copy to .env.local and fill in.

# Supabase (v2 project) — client-safe values
NEXT_PUBLIC_SUPABASE_URL=https://<v2-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Server-only. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Direct Postgres connection for Drizzle (server-only).
DATABASE_URL=postgres://postgres:<pw>@<host>:5432/postgres

# Apex domain used to derive tenant subdomains (e.g. outdure.app).
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Observability (optional in dev)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Stripe (server-only)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...
