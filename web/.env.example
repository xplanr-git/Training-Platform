# Next.js app environment. Copy to .env.local and fill in.

# Supabase (v2 project) — client-safe values
NEXT_PUBLIC_SUPABASE_URL=https://<v2-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Server-only. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Direct Postgres connection for Drizzle (server-only).
DATABASE_URL=postgres://postgres:<pw>@<host>:5432/postgres

# Apex domain used to derive tenant subdomains (e.g. outdure.app).
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Bunny Stream — the video host. Without these, every video lesson renders the
# "host not configured" state rather than a player, so a fresh clone has no
# working video until they are set. Library id + per-library access key; the CDN
# hostname is only needed for direct HLS (the iframe embed keys on library id).
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_CDN_HOSTNAME=

# Observability (optional in dev)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Source-map upload, so a production stack trace names our source instead of a
# minified column. Build-time only; without all three the build simply skips the
# upload. Get the token from Sentry → Settings → Auth Tokens (project:releases).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Shared rate-limit store (optional). Without these, limits are counted
# PER-INSTANCE and a Vercel cold start resets them — which bounds nothing on a
# serverless deployment. With them, every rule marked `shared` in lib/rate-limit
# is counted across all instances in one atomic Redis sliding window. If the
# store is unreachable the limiter falls back per-instance rather than refusing
# everybody. Upstash Redis → REST API section.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email (Resend, server-only) — omit to no-op emails in dev
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com

# Stripe (server-only)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...

# Optional. Single-tenant mode: the apex host serves this one academy, so
# `/admin` and `/learn/...` resolve without a tenant subdomain. Leave unset for
# multi-tenant subdomain routing (`acme.example.com` -> tenant `acme`).
DEFAULT_TENANT_SLUG=

# --- Live E2E suite (tests/live) — `npm run test:live` ---------------------
# These specs sign in and WRITE: courses, sections, lessons, enrollments,
# certificates, and in signup-provision.spec.ts a whole tenant plus an auth
# user. They write to whichever Supabase project the SERVER UNDER TEST uses, so
# point them at a non-production project. Off unless ALLOW_LIVE_WRITES=1.
ALLOW_LIVE_WRITES=
# An existing admin on the target project. No defaults — a made-up address just
# produces a confusing login failure instead of a clear precondition skip.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
# Origin of the running server, on a tenant subdomain (Chromium resolves
# *.localhost). Defaults to http://demo.localhost:3010.
LIVE_BASE_URL=

# --- RLS attack probes (tests/live/rls-attacks.spec.ts) --------------------
# Regression cover for migration 0014. These specs ATTACK PostgREST directly
# with a learner's own session — attempting self-promotion to platform_admin, a
# forged certificate, a free enrolment, an answer-key read, a self-completion
# and a forged audit entry. Every one must be refused.
#
# They have their own target vars ON PURPOSE. Reusing NEXT_PUBLIC_SUPABASE_URL
# would inherit .env.local, which points at PRODUCTION. Point these at a
# DISPOSABLE project seeded with one learner account; the suite refuses to run
# if this URL matches the app's. Also needs ALLOW_LIVE_WRITES=1.
RLS_PROBE_SUPABASE_URL=
RLS_PROBE_ANON_KEY=
RLS_PROBE_LEARNER_EMAIL=
RLS_PROBE_LEARNER_PASSWORD=
