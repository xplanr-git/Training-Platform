    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.22",
    "jsdom": "^25.0.1",
    "prettier": "3.6.2",
